PORT="3210"

ENVIRONMENT="DEV" #LOCAL, DEV, QA, PROD
APP_NAME="base-nestjs-backend"
APP_DESCRIPTION="Base para desarrollar APIs HTTP con NestJS y TypeScript. Reúne configuración, validación, logs, monitoreo de salud y pruebas unitarias para servir como punto de partida de nuevos proyectos backend."
APP_VERSION="1.0.0"

LOG_LEVEL="ALL" #ALL, TRACE, DEBUG, INFO, WARN, ERROR, FATAL, MARK, OFF
LOG_MODE="loki" #log4js, loki
LOG_DIR="./logs"
LOG_NAME="base-nestjs-backend"
LOKI_URL="http://127.0.0.1:3100"

AUTH_DATABASE_HOST="127.0.0.1"
AUTH_DATABASE_PORT="5423"
AUTH_DATABASE_USERNAME="postgresusr"
AUTH_DATABASE_PASSWORD="postgrespwd"
AUTH_DATABASE_NAME="auth"
AUTH_DATABASE_SYNCRONIZE="false"
AUTH_DATABASE_LOGGING="false"
AUTH_DATABASE_MIGRATIONSRUN="true"
AUTH_DATABASE_MAXEXECUTIONTIME="30000"

JWT_SECRET="mi_secret_key"
JWT_EXPIRESIN="900000" #15m
JWT_REFRESH_SECRET="mi_refresh_secret_key"
JWT_REFRESH_EXPIRESIN="3600000" #1h